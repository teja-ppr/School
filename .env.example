# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_API_TIMEOUT=30000

# School Configuration (Placeholders - Update Later)
REACT_APP_SCHOOL_NAME=[School Name]
REACT_APP_SCHOOL_AFFILIATION=[Affiliation Number]
REACT_APP_SCHOOL_CODE=[School Code]
REACT_APP_SCHOOL_ADDRESS=[School Address]
REACT_APP_SCHOOL_PHONE=[Contact Number]
REACT_APP_SCHOOL_EMAIL=[Email Address]
REACT_APP_PRINCIPAL_NAME=[Principal Name]

# Social Media Links
REACT_APP_FACEBOOK_URL=https://facebook.com/
REACT_APP_TWITTER_URL=https://twitter.com/
REACT_APP_INSTAGRAM_URL=https://instagram.com/
REACT_APP_YOUTUBE_URL=https://youtube.com/

# SEO Configuration
REACT_APP_SEO_TITLE=[School Name] - Official Website
REACT_APP_SEO_DESCRIPTION=Official website of [School Name]. CBSE affiliated school providing quality education.
REACT_APP_SEO_KEYWORDS=school,CBSE,education,academic

# Map Configuration
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment
REACT_APP_ENV=development
NODE_ENV=development
